# Docker deployment config (copy to .env)
# Docker Hub image published by this repository; see README for details.
ARTEX_IMAGE=ruoji6/artex
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (fill one or more; can also be left empty and configured in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# HTTP User-Agent; when empty a random browser UA is chosen from the built-in samples
ARTEX_HTTP_USER_AGENT=
